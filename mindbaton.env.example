# Mindbaton settings. Copy to mindbaton.env (next to server.py) and edit; ./install.sh writes one for you.
# Real environment variables win over this file. Restart the server after a change.

# Address to listen on. 127.0.0.1 = this computer only; 0.0.0.0 = every device on your network (installers use this).
MINDBATON_HOST=0.0.0.0
# Port to listen on.
MINDBATON_PORT=3004

# Where your data lives: mindbaton.db, ai_keys, access.log. Default: the data/ folder next to server.py.
#MINDBATON_DATA=/srv/mindbaton

# Your public HTTPS address, if you have one (Tailscale Funnel, Cloudflare Tunnel, a reverse proxy).
# Used in the copy-paste setup instructions; without it they use the address you opened the page on.
#MINDBATON_PUBLIC_URL=https://mindbaton.example.com

# The optional AI (writes hand-off summaries, topic names and search answers). 0 = off; rules still do everything else.
#MINDBATON_AI=0
# Free-tier daily request caps for the optional AI (search answers can't use up what hand-offs need).
#MINDBATON_AI_DAILY=400
#MINDBATON_AI_ASK_DAILY=200
# Which models the optional AI uses.
#MINDBATON_GEMINI_MODEL=gemini-3.6-flash
#MINDBATON_GROQ_MODEL=openai/gpt-oss-120b
# Keys: easiest is to paste them on the Setup page (saved to <data>/ai_keys, readable only by you). Or set them here:
#GEMINI_KEY=
#GROQ_KEY=
# Paid keys (OpenAI, Claude): used only when the free ones can't answer, with each provider's cheapest model.
#OPENAI_KEY=
#ANTHROPIC_KEY=
#MINDBATON_OPENAI_MODEL=gpt-6-luna
#MINDBATON_CLAUDE_MODEL=claude-haiku-4-5
# The most the paid keys may cost in a month (US dollars, as Mindbaton counts it). 0 never uses them.
#MINDBATON_AI_MONTHLY_USD=2

# 0 = don't read Claude Code's local transcripts (~/.claude/projects) on this machine.
#MINDBATON_WATCH_CLAUDE=0

# Once a day, ask GitHub if a newer Mindbaton is out (admins see a notice). 0 = never check.
#MINDBATON_UPDATE_CHECK=0
